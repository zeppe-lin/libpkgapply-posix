option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'How libpkgapply-posix links against dependencies',
)
option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build and run the POSIX mechanism test suite',
)
option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Install the libpkgapply-posix manual page',
)
